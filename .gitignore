# Virtual environments
.venv/
venv/
ENV/
env/

# Python bytecode and local tooling caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# SQLite databases & transient database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# External datasets & downloads
Basketball.v1i.yolov8/
Claude outputs/

# User data & transient uploads/caches
user_data/

# Model checkpoints & tasks (retained essential assets un-ignored for zero-download onboarding)
*.task
*.pt
*.onnx
!pose_landmarker.task
!hand_landmarker.task
!models/
!models/*.pt

# External clones and vendored repos
clones/

# Video footage and raw clips: allow tracked clips, ignore untracked
raw_clips/
*.mov
*.avi
*.mkv
!raw_clips/Mikedunn.mp4
!raw_clips/klay_vid.mp4
!raw_clips/mikeddunnstud1.mp4
!raw_clips/mikeddunnstud2.mp4

# Session recordings and exported CSVs
session_*.csv
sessions_csv/

# Local HTTPS certificates for phone access (never commit private keys)
*.pem
certs/

# Generated benchmark and evaluation reports
EVAL_REPORT.json
KLAY_EVAL_REPORT.json
DATASET_EVAL_REPORT.json
RAW_CLIPS_TEST_REPORT.json
PUBLIC_DATASETS_REPORT.json

# Scratch inspection scripts
scratch_*.py

# Graphify transient caches and interpreter bookkeeping
graphify-out/cache/
graphify-out/[0-9]*/
graphify-out/202*
graphify-out/.vocab.txt
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_chunk_*.json
graphify-out/.needs_update
graphify-out/last_query_stamp
graphify-out/.fuse_hidden*
graphify-out/*.pending.json

# Paper drafts and presentations
/reports_for_paper

# OS and IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
