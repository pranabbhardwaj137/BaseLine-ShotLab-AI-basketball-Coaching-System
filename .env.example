# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real keys.
# Shot Lab reads this file at start-up; values already set in the environment take precedence.

# --- AI coach chat with xAI Grok (official API: https://api.x.ai/v1/responses) ---
# Create a key at https://console.x.ai . API usage is billed to your xAI account (needs credits).
XAI_API_KEY=xai-your-key-here
# Model id. Default grok-4.7 (xAI's documented flagship). Use a model listed for your account in the xAI Console.
XAI_MODEL=grok-4.7

# --- Optional: Google Gemini instead (needs --enable-llm-chat --llm-provider gemini) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Optional: fixed access code for --lan (default: a new random code each start) ---
# SHOTLAB_ACCESS_CODE=
