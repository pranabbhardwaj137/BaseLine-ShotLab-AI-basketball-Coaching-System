# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real keys.
# Shot Lab reads this file at start-up; non-empty values already set in the environment take precedence.

# --- AI coach chat: Groq is the primary provider (official API: https://api.groq.com/openai/v1/chat/completions)
# Create a key at https://console.groq.com/keys . Free and paid plans have rate/usage limits.
GROQ_API_KEY=your_groq_api_key
# Optional. Default openai/gpt-oss-120b (a production model on Groq). See https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# --- Backup: Google Gemini, used when Groq is rate-limited, times out or is temporarily unavailable
# Create a key at https://aistudio.google.com/apikey . Quotas and billing depend on your Google project.
GEMINI_API_KEY=your_gemini_api_key
# Optional. Default gemini-3.8-flash. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.8-flash

# --- Optional: xAI Grok, only used with --llm-provider xai
# XAI_API_KEY=
# XAI_MODEL=grok-4.7

# --- Optional: fixed access code for --lan (default: a new random code each start)
# SHOTLAB_ACCESS_CODE=
